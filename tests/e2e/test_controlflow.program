// Test if statements
int64 testIf(int64 x){
  int64 result
  result = 0
  if(x > 10){
    result = 1
  }
  return result
}

// Test nested if statements
int64 testNestedIf(int64 x, int64 y){
  int64 result
  result = 0
  if(x > 0){
    if(y > 0){
      result = 1
    }
  }
  return result
}

// Test if with complex condition
int64 testIfComplexCond(int64 x, int64 y){
  int64 result, sum
  result = 0
  sum = x + y
  if(sum > 10){
    result = sum
  }
  return result
}

// Test while loop with if inside
int64 testWhileWithIf(int64 n){
  int64 i, sum
  i = 0
  sum = 0
  while(i < n){
    if(i < 5){
      sum = sum + i
    }
    i = i + 1
  }
  return sum
}

// Test nested while loops
int64 testNestedWhile(int64 n, int64 m){
  int64 i, j, count
  i = 0
  count = 0
  while(i < n){
    j = 0
    while(j < m){
      count = count + 1
      j = j + 1
    }
    i = i + 1
  }
  return count
}

// Test finding element in array
int64 testEarlyReturn(int64[10] arr, int64 target){
  int64 i, found, result
  i = 0
  found = 0
  result = 0 - 1
  while(i < 10){
    if(arr[i] == target){
      result = i
      found = 1
    }
    i = i + 1
  }
  return result
}

// Test multiple conditions with comparison operators
int64 testComparisons(int64 a, int64 b){
  int64 result
  result = 0
  if(a < b){
    result = result + 1
  }
  if(a <= b){
    result = result + 10
  }
  if(a == b){
    result = result + 100
  }
  if(a >= b){
    result = result + 1000
  }
  if(a > b){
    result = result + 10000
  }
  return result
}
