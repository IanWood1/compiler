// Forward array by value
int64[10] test4_forward(int64[10] x){
    return x
}

// Forward array by reference
int64[10]& test4_forward2(int64[10]& x){
    return x
}

// Chain reference forwarding
int64[10]& test4_forward3(int64[10]& x){
    int64[10]& b
    b = test4_forward2(x)
    return b
}

// Compare arrays: one by reference, one by value
int64 test4_compare(int64[10]& arr1, int64[10] arr2){
    int64 i, res
    i = 0
    res = 0
    while (i < 10) {
        int64 cmp
        cmp = arr1[i] == arr2[i]
        if(cmp == 0){
            res = 1
        }
        i = i + 1
    }
    return res
}

// Test array comparison - returns zero if arrays are the same
// Creates local references to enable passing to test4_compare
int64 test4(int64[10] arr1, int64[10] arr2){
    int64 res
    int64[10]& ref1
    int64[10]& ref2
    res = 0

    ref1 = arr1
    ref2 = arr2
    res = res + test4_compare(ref1, arr2)
    res = res + test4_compare(ref2, arr1)
    return res
}
